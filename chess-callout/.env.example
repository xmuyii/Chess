# Copy this file to .env and fill in real values.
# .env should NEVER be committed to git — add it to .gitignore.

# --- Supabase (required always) ---------------------------------
# Find both in your Supabase project: Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Game link signing (required always) ------------------------
# Any long random string you generate yourself — not from a website.
# Run this locally to make one:  python -c "import secrets; print(secrets.token_hex(32))"
GAME_TOKEN_SECRET=replace-with-a-long-random-string

# --- Game link base URL ------------------------------------------
# Local testing: leave as-is (http://localhost:5000/game).
# After deploying to Railway: set this to your Railway web service's
# public URL + /game, e.g. https://your-app.up.railway.app/game
# This MUST match on every service that generates links (the Telegram
# worker) and the web service itself.
GAME_WEB_BASE_URL=http://localhost:5000/game

# --- Cross-platform API (only needed if you're integrating a new
# platform purely over HTTP via api/core_api.py, e.g. Discord/Slack/
# a website widget — not needed for the built-in WhatsApp/Telegram adapters) ---
# Any long random string you generate yourself, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
CORE_API_KEY=replace-with-a-long-random-string

# --- WhatsApp Cloud API (not needed yet — skip while testing Telegram-only) ---
# WA_VERIFY_TOKEN: you make this one up yourself (any string), then enter
#   the SAME value in Meta's webhook config screen.
# WA_ACCESS_TOKEN / WA_PHONE_NUMBER_ID: from developers.facebook.com,
#   your app -> WhatsApp -> API Setup.
WA_VERIFY_TOKEN=any-string-you-pick
WA_ACCESS_TOKEN=your-whatsapp-cloud-api-access-token
WA_PHONE_NUMBER_ID=your-whatsapp-phone-number-id

# --- Telegram (required only if using the Telegram adapter) -----
# Get this by messaging @BotFather on Telegram and running /newbot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Your bot's @username (no @, shown in the adapter's "Connected as @..."
# startup log) — needed to build cold-callout invite links (t.me/...).
TELEGRAM_BOT_USERNAME=your_bot_username

# --- GOWA (unofficial WhatsApp, alternative to official Cloud API) ---
# UNOFFICIAL — real ban risk for the number you use. See README before
# relying on this. Only needed if using adapters/gowa_adapter.py.
GOWA_BASE_URL=http://localhost:3000
GOWA_WEBHOOK_SECRET=some-secret-you-choose
GOWA_DEVICE_ID=
GOWA_BASIC_AUTH_USER=
GOWA_BASIC_AUTH_PASS=
